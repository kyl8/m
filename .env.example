# MQTT pode estar em outra máquina. Informe IP ou nome DNS.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=portos/lorawan/uplink
MQTT_QOS=1
MQTT_TIMEOUT=10
MQTT_RECONNECT_MIN=1
MQTT_RECONNECT_MAX=30

# Este cliente implementa a API do InfluxDB 2.x.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_TIMEOUT_MS=10000
INFLUX_BATCH_SIZE=100
INFLUX_FLUSH_INTERVAL_MS=1000

PENDING_DB=pending_queue.db
STATE_DB=system_state.db
LOG_LEVEL=INFO
POLLUTION_THRESHOLD_NTU=15

